{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:clavia:trace:atif-v1.7",
  "title": "Clavia ATIF v1.7 storage profile",
  "description": "A full-fidelity ATIF v1.7 trajectory with the Clavia review metadata required by the trace store.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "trajectory_id", "agent", "steps", "extra"],
  "properties": {
    "schema_version": { "const": "ATIF-v1.7" },
    "session_id": { "type": "string" },
    "trajectory_id": { "type": "string", "minLength": 1 },
    "agent": { "$ref": "#/$defs/agent" },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "notes": { "type": "string" },
    "final_metrics": { "$ref": "#/$defs/finalMetrics" },
    "continued_trajectory_ref": { "type": "string" },
    "subagent_trajectories": { "type": "array", "items": { "$ref": "#" } },
    "extra": {
      "type": "object",
      "required": ["clavia"],
      "properties": { "clavia": { "$ref": "#/$defs/claviaMetadata" } },
      "additionalProperties": true
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "model_name": { "type": "string" },
        "tool_definitions": { "type": "array" },
        "extra": { "type": "object" }
      }
    },
    "contentPart": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "text"],
          "properties": { "type": { "const": "text" }, "text": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "source"],
          "properties": {
            "type": { "const": "image" },
            "source": {
              "type": "object",
              "required": ["media_type", "path"],
              "properties": {
                "media_type": { "enum": ["image/jpeg", "image/png", "image/gif", "image/webp"] },
                "path": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "message": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/contentPart" } }
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "prompt_tokens": { "type": "number", "minimum": 0 },
        "completion_tokens": { "type": "number", "minimum": 0 },
        "cached_tokens": { "type": "number", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "prompt_token_ids": { "type": "array", "items": { "type": "integer" } },
        "completion_token_ids": { "type": "array", "items": { "type": "integer" } },
        "logprobs": { "type": "array", "items": { "type": "number" } },
        "extra": { "type": "object" }
      }
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": true,
      "required": ["tool_call_id", "function_name", "arguments"],
      "properties": {
        "tool_call_id": { "type": "string", "minLength": 1 },
        "function_name": { "type": "string", "minLength": 1 },
        "arguments": { "type": "object" },
        "extra": { "type": "object" }
      }
    },
    "observationResult": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source_call_id": { "type": "string" },
        "content": { "$ref": "#/$defs/message" },
        "subagent_trajectory_ref": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "trajectory_id": { "type": "string" },
              "trajectory_path": { "type": "string" },
              "session_id": { "type": "string" }
            },
            "anyOf": [
              { "required": ["trajectory_id"] },
              { "required": ["trajectory_path"] },
              { "required": ["session_id"] }
            ]
          }
        },
        "extra": { "type": "object" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": true,
      "required": ["step_id", "source", "message"],
      "properties": {
        "step_id": { "type": "integer", "minimum": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "source": { "enum": ["system", "user", "agent"] },
        "model_name": { "type": "string" },
        "reasoning_effort": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
        "message": { "$ref": "#/$defs/message" },
        "reasoning_content": { "type": "string" },
        "tool_calls": { "type": "array", "items": { "$ref": "#/$defs/toolCall" } },
        "observation": {
          "type": "object",
          "required": ["results"],
          "properties": { "results": { "type": "array", "items": { "$ref": "#/$defs/observationResult" } } }
        },
        "metrics": { "$ref": "#/$defs/metrics" },
        "llm_call_count": { "type": "integer", "minimum": 0 },
        "is_copied_context": { "type": "boolean" },
        "extra": { "type": "object" }
      }
    },
    "finalMetrics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "total_prompt_tokens": { "type": "number", "minimum": 0 },
        "total_completion_tokens": { "type": "number", "minimum": 0 },
        "total_cached_tokens": { "type": "number", "minimum": 0 },
        "total_cost_usd": { "type": "number", "minimum": 0 },
        "total_steps": { "type": "integer", "minimum": 0 },
        "extra": { "type": "object" }
      }
    },
    "failureMode": {
      "type": "object",
      "required": ["id", "verdict"],
      "properties": {
        "id": { "type": "string" },
        "verdict": { "enum": ["PASS", "FAIL", "NOT_ASSESSABLE"] },
        "justification": { "type": "string" }
      }
    },
    "claviaMetadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "title", "source", "outcome", "behavior"],
      "properties": {
        "schema_version": { "const": "clavia.trace-metadata/v1" },
        "title": { "type": "string" },
        "source": {
          "type": "object",
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["legalbench", "atif", "letta", "otel", "braintrust", "langfuse"] },
            "id": { "type": "string" }
          }
        },
        "task": {
          "type": "object",
          "required": ["id"],
          "properties": { "id": { "type": "string" }, "work_type": { "type": "string" } }
        },
        "outcome": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "type": "string" },
            "strict_pass": { "type": "boolean" },
            "checkpoint_passed": { "type": "number", "minimum": 0 },
            "checkpoint_total": { "type": "number", "minimum": 0 },
            "alignment": { "type": "string" },
            "usefulness": {
              "type": "object",
              "properties": {
                "clarity": { "type": "number" },
                "length": { "type": "number" },
                "structure": { "type": "number" }
              }
            }
          }
        },
        "behavior": {
          "type": "object",
          "required": ["class", "summary", "tags"],
          "properties": {
            "class": { "enum": ["single-shot", "direct-builder", "research-first", "iterative-refiner", "recovery-loop", "answer-only"] },
            "summary": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } }
          }
        },
        "duration_ms": { "type": "number", "minimum": 0 },
        "failure_modes": { "type": "array", "items": { "$ref": "#/$defs/failureMode" } },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string" },
              "bytes": { "type": "number", "minimum": 0 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "provider": { "type": "object" }
      }
    }
  }
}
