{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:clavia:trace:query-v1",
  "title": "Clavia trace query",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_id", "metrics"],
  "properties": {
    "dataset_id": { "type": "string" },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "op", "value"],
        "properties": {
          "field": { "$ref": "#/$defs/field" },
          "op": { "enum": ["eq", "neq", "in"] },
          "value": {
            "oneOf": [
              { "type": "string" },
              { "type": "boolean" },
              { "type": "array", "items": { "oneOf": [{ "type": "string" }, { "type": "boolean" }] } }
            ]
          }
        }
      }
    },
    "group_by": { "$ref": "#/$defs/field" },
    "metrics": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/metric" } },
    "order_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "direction"],
      "properties": { "metric": { "$ref": "#/$defs/metric" }, "direction": { "enum": ["asc", "desc"] } }
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 1000 }
  },
  "$defs": {
    "field": { "enum": ["model", "agent", "source", "task_id", "work_type", "status", "strict_pass", "alignment", "behavior", "tool_name"] },
    "metric": { "enum": ["trace_count", "pass_rate", "checkpoint_rate", "avg_usefulness", "avg_cost_usd", "avg_duration_ms", "avg_tool_calls", "avg_prompt_tokens", "avg_completion_tokens"] }
  }
}
