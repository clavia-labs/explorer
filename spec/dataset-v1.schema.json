{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:clavia:trace:dataset-v1",
  "title": "Clavia immutable trace dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "name", "created_at", "source", "traces", "object_sha256"],
  "properties": {
    "schema_version": { "const": "clavia.dataset/v1" },
    "dataset_id": { "type": "string", "pattern": "^ds_[a-f0-9]{24}$" },
    "name": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string" },
        "id": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "traces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trace_id", "object_sha256"],
        "properties": {
          "trace_id": { "type": "string" },
          "object_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "object_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
