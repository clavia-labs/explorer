{
  "name": "@clavia/explorer",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.1",
  "scripts": {
    "build": "vite build",
    "deploy": "bunx --bun wrangler deploy",
    "dev": "vite",
    "dev:cloudflare": "bun run build && bunx --bun wrangler dev",
    "gate": "bun run typecheck && bun run test && bun run build && bunx --bun wrangler deploy --dry-run",
    "import": "bun run src/cli.ts import",
    "mcp": "bun run src/mcp.ts",
    "serve": "bun run src/server.ts",
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "types:cloudflare": "bunx --bun wrangler types"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@modelcontextprotocol/server": "2.0.0",
    "lucide-react": "1.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260819.1",
    "@types/bun": "1.3.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "6.0.3",
    "vite": "6.3.0",
    "wrangler": "4.124.0"
  }
}
